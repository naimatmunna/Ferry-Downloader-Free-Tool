# Ferry on Vercel (trial). Paste these into Vercel:
# Project > Settings > Environment Variables (it accepts pasted .env text).
# apps/server/test/unit/vercel-deploy.test.js checks that they start the server.

# Vercel sends traffic to port 80 unless PORT is set. Ferry runs as a locked-down
# user that can't open ports below 1024, so it listens on 8787.
PORT=8787

# Required. Set a long random value in Vercel and mark it Sensitive, for example
# the output of: openssl rand -base64 48. Never put the real value in git.
SIGNING_SECRET=

# Optional, 32+ characters: lets you switch sites off with the admin API.
# ADMIN_TOKEN=

# Vercel replaces X-Forwarded-For with the visitor's own address, so trust one
# hop. Each visitor then gets their own rate limits.
TRUST_PROXY=1

# Keep Ferry's working files in /tmp. A Vercel container's disk is temporary
# and /tmp is always writable; finished files are temporary in Ferry anyway.
DATA_DIR=/tmp/ferry

# Smaller limits, so one download fits Vercel's 5-minute request limit, its
# small temporary disk and the free plan's single CPU. Raise them with care.
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_PROBES=2
MAX_FILESIZE_MB=250
MAX_DURATION_SECONDS=1800
MAX_STORAGE_MB=1024
MIN_FREE_DISK_MB=256
JOB_TTL_MINUTES=15
JOB_TIMEOUT_MS=600000
