# Ferry configuration. Copy to .env and adjust. Every value has a safe default
# except SIGNING_SECRET, which production requires.

# --- Server ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
# Behind a reverse proxy, trust its X-Forwarded-For (number of hops or CIDRs).
TRUST_PROXY=1
# Same-origin by default. Only set when the web app is served from another origin.
CORS_ORIGINS=
DATA_DIR=/data
FERRY_DOMAIN=ferry.example.com

# --- Secrets (never commit real values) -----------------------------------
# 32+ random bytes, e.g.: openssl rand -base64 48
SIGNING_SECRET=
# Enables /api/v1/admin/* when set (32+ characters).
ADMIN_TOKEN=

# --- Engines ---------------------------------------------------------------
YTDLP_PATH=/opt/yt-dlp/bin/yt-dlp
# Image galleries (optional). Without it, gallery platforms show as unavailable.
GALLERYDL_PATH=/opt/gallery-dl/bin/gallery-dl
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# No JavaScript runtime by default (yt-dlp only needs one to solve YouTube's
# challenges, which Ferry does not do). See docs/RESEARCH.md before changing.
YTDLP_JS_RUNTIME=none
FFMPEG_THREADS=2
USER_AGENT=Ferry/1.0 (self-hosted media downloader; contact: admin@example.com)

# --- Limits ----------------------------------------------------------------
MAX_DURATION_SECONDS=10800
MAX_FILESIZE_MB=2048
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_PROBES=4
MAX_QUEUE_LENGTH=100
MAX_ACTIVE_JOBS_PER_CLIENT=4
JOB_TTL_MINUTES=60
JOB_MAX_RETENTION_MINUTES=1440
PROBE_TIMEOUT_MS=45000
JOB_TIMEOUT_MS=3600000
STALL_TIMEOUT_MS=120000
MIN_FREE_DISK_MB=1024
MAX_STORAGE_MB=20480
MAX_PLAYLIST_ITEMS=50
MAX_BATCH_URLS=20
# Image galleries: images listed per post, largest single image, decode budget.
MAX_GALLERY_ITEMS=100
MAX_IMAGE_MB=100
MAX_IMAGE_MEGAPIXELS=100

# --- Rate limits (per client per minute) ------------------------------------
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_PROBE_PER_MIN=30
RATE_LIMIT_JOBS_PER_MIN=20

# --- Network ---------------------------------------------------------------
EGRESS_ALLOWED_PORTS=80,443,8080,8443
EGRESS_MAX_CONNECTIONS=256
# TEST ONLY — refused when NODE_ENV=production.
SSRF_ALLOW_HOSTS=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# Client IPs are personal data under GDPR; keep this off unless you need it.
LOG_CLIENT_IP=false
LOG_PRETTY=false
